# ===== VPS (docker compose) — copie para .env e preencha com valores reais =====

# Domínio único (aponte no DNS: A/AAAA de APP_DOMAIN para a VPS)
APP_DOMAIN=gastos.seudominio.com.br
ACME_EMAIL=voce@seudominio.com.br

# Postgres: superusuário (admin/backup) e usuário da aplicação (sem superusuário — RLS)
POSTGRES_PASSWORD=gere-uma-senha-longa
APP_DB_USER=gastos
APP_DB_PASSWORD=gere-outra-senha-longa
APP_DB_NAME=gastos

# apps/api — sessão
SESSION_SECRET=gere-um-segredo-longo-e-aleatorio   # openssl rand -hex 32
SESSION_IDLE_DAYS=30
# Criptografa em repouso o que é sensível no banco (tokens de bancos, segredo de 2FA).
# AES-256-GCM, 32 bytes em hex. Trocar exige rotação (09-operacao § 6).
DATA_ENCRYPTION_KEY=gere-32-bytes-em-hex           # openssl rand -hex 32

# Integração bancária (Pluggy) — ver docs/specs/07-integracao-bancaria.md
PLUGGY_CLIENT_ID=gere-no-painel-do-pluggy
PLUGGY_CLIENT_SECRET=gere-no-painel-do-pluggy
# OPCIONAL: só se um dia houver plano pago com webhook (o Meu Pluggy não tem). Sem isto o sync é por job.
# PLUGGY_WEBHOOK_SECRET=gere-um-segredo-longo         # openssl rand -hex 32

# IA (Groq API, console.groq.com) — ver docs/specs/10-ia.md. Vazio = recursos de IA desligados.
GROQ_API_KEY=
AI_MODEL=openai/gpt-oss-20b
AI_MONTHLY_TOKEN_BUDGET=200000

# E-mail transacional (esqueci minha senha, convite, aviso de consentimento vencendo) — SMTP externo
MAIL_TRANSPORT=smtp
MAIL_FROM=AbacaTudo <no-reply@seudominio.com.br>
MAIL_HOST=smtp.provedor.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_AUTH_USER=
MAIL_AUTH_PASS=
# Sem WEB_ORIGIN aqui: em produção o link de reset usa o próprio APP_DOMAIN (docker-compose.yml já monta
# WEB_ORIGIN=https://${APP_DOMAIN} pro container da API).

# Só usados pelo seed — bootstrap do primeiro usuário (idempotente por e-mail).
# SEED_USER_EMAIL=voce@seudominio.com.br
# SEED_USER_PASSWORD=troque-depois-do-primeiro-login
# SEED_USER_NAME=Seu Nome
